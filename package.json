{
  "name": "syu-go",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:live": "node --env-file=.env.local --experimental-strip-types scripts/check-membership-live.mjs",
    "test:participants:live": "node --env-file=.env.local --experimental-strip-types scripts/check-participants-live.mjs",
    "test:location:live": "node --env-file=.env.local --experimental-strip-types scripts/check-location-live.mjs",
    "test:pins:live": "node --env-file=.env.local --experimental-strip-types scripts/check-pins-live.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
